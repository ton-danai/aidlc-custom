{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 30,
            "statusMessage": "aidlc-custom: hooks path, audit rotation, state size"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_read.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
